{
  "expo": {
    "name": "ShareNami",
    "slug": "sharenami",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/lo1.png",
    "scheme": "sharenami",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo/lo1.png",
      "bundleIdentifier": "com.nyandanonethononda.ShareNami"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo/lo1.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nyandanonethononda.ShareNami"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo/lo1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logo/lo1.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d02ad50f-4102-4929-9d95-1f0600aa523b"
      }
    },
    "owner": "nyandano-nethononda"
  }
}
